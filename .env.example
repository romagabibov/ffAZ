# Server variables. Add these in Vercel > Project > Settings > Environment Variables.
# Paste the complete Firebase service-account JSON for the project in firebase-applet-config.json.
# Never prefix a service-account key or Cloudinary secret with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production secrets for encrypted manual identity review and daily deletion.
# Base64 of 32 randomly generated bytes. Retain the active and retired keys securely.
AFW_IDENTITY_KEY=
AFW_IDENTITY_PREVIOUS_KEYS=
# A separate random secret of at least 32 characters for Vercel Cron.
CRON_SECRET=

# Production only, for the initial Firebase preparation in a Vercel build.
# Keep unset during normal deployments and all previews.
AFW_PREPARE_FIREBASE=
# Optional, for the first preparation of a database with no superadmin role.
AFW_INITIAL_SUPERADMIN_UID=
# Optional document-read budget for a resumable preparation run.
AFW_PREPARE_READ_BUDGET=8000

# Your canonical HTTPS domain. The current Vercel deployment host is also accepted.
APP_URL=

# ABB ePOS on Azericard. Confirm RSA/SHA256 and JSON transaction inquiry with the bank.
# Use production credentials in Vercel Production. Test credentials belong with local emulators.
ABB_EPOS_GATEWAY_URL=
ABB_EPOS_TERMINAL=
ABB_EPOS_MERCHANT_NAME=
ABB_EPOS_MERCHANT_PRIVATE_KEY=
ABB_EPOS_GATEWAY_PUBLIC_KEY=
# Hard maximum bank checkout lifetime, including completion, confirmed for the terminal.
ABB_EPOS_CHECKOUT_TTL_SECONDS=

# Optional education assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional App Check. Register the web app and domains in Firebase App Check first.
# Deploy the site key, confirm valid requests, then enable enforcement.
VITE_RECAPTCHA_SITE_KEY=
ENFORCE_APP_CHECK=false
