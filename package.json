{
  "name": "az-fashion-events",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/bundle-server-deps.mjs",
    "dev": "node --import tsx server.ts",
    "dev:emulator": "node --import tsx scripts/dev-emulator.ts",
    "emulators": "firebase emulators:start --project demo-afw-local --config firebase.local.json --only firestore,auth",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "npm run test:emulator",
    "start": "node --import tsx server.ts",
    "build:vercel": "node --import tsx scripts/build-vercel.ts",
    "test:emulator": "firebase emulators:exec --project demo-afw-secure --only firestore \"vitest run tests/integration\"",
    "firebase:prepare": "node --import tsx scripts/prepare-deploy.ts"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@hookform/resolvers": "^5.2.2",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "i18next": "^26.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "react-router": "^7.14.2",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.32.1",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "uuid": "11.1.1",
    "qs": "^6.17.1",
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "tsx": {
      "esbuild": "^0.28.1"
    },
    "glob@>=9": "14.0.2",
